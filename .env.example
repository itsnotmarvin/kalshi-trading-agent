# Start safely: mock produces HOLD-only proposals and paper never places orders.
LLM_PROVIDER=mock
PLATFORM=kalshi
TRADING_MODE=paper

# Choose one model provider when leaving mock mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_SCAN_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SCAN_MODEL=gpt-5.4-mini
MARKET_SCAN_LIMIT=0

# Optional web-research provider. DuckDuckGo is the no-key fallback.
TAVILY_API_KEY=

# Required for authenticated Kalshi access. Keep the private key outside Git.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# Experimental adapters. Polymarket live execution is not implemented.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Optional integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_API_TOKEN=

# Local runtime storage; relative paths resolve from the project root.
KALSHI_DATA_DIR=data/runtime
LOG_FILE=data/runtime/trades.jsonl

# Risk and execution policy.
PAPER_BALANCE=1000
MAX_PORTFOLIO_VALUE=500
MAX_SINGLE_TRADE=25
MAX_DAILY_LOSS=50
MIN_EDGE_THRESHOLD=0.08
WEATHER_MIN_EDGE_THRESHOLD=0.12
MIN_POSITION_SIZE=3
MAX_ORDERBOOK_SPREAD=0.08
MIN_ORDERBOOK_DEPTH_USD=25
MAX_CATEGORY_EXPOSURE_PCT=0.35
MIN_MARKET_VOLUME=50000
MIN_PAYOUT_LIKELIHOOD=0
TAKE_PROFIT_THRESHOLD=0.20
USE_MAKER_ORDERS=false
BLOCKED_CATEGORIES=Economics
CYCLE_INTERVAL_MINUTES=30
ALLOW_WEATHER_LIVE_BEFORE_VALIDATION=false

# World Cup route gates.
# Archived 2026 World Cup route. Leave disabled outside historical replay.
WORLD_CUP_ENABLED=false
WORLD_CUP_OPENAI_ENABLED=false
WORLD_CUP_BOTH_MODE_ENABLED=false
WORLD_CUP_BOTH_COMBINATION_RULE=
WORLD_CUP_CLAUDE_MODEL=claude-opus-5
WORLD_CUP_CLAUDE_FALLBACK_MODEL=
WORLD_CUP_SCHEDULE_DAYS_AHEAD=45
WORLD_CUP_QUOTE_FRESH_SECONDS=30
WORLD_CUP_COMBO_QUOTE_FRESH_SECONDS=10
WORLD_CUP_CALIBRATION_FILE=data/runtime/world_cup_calibration.json
