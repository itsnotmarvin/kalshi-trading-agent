# Safe local-development defaults. No paid model calls or order placement.
LLM_PROVIDER=mock
TRADING_MODE=paper
PLATFORM=kalshi
PAPER_BALANCE=1000

# Optional credentials for authenticated account and market access.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Optional research providers. Leave blank for mock development.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Risk defaults
MAX_SINGLE_TRADE=25
MAX_DAILY_LOSS=50
MIN_EDGE_THRESHOLD=0.08
ALLOW_WEATHER_LIVE_BEFORE_VALIDATION=false
